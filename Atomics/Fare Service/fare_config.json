  "transfer_rules": {
    "_description": "Rules governing when consecutive trips count as a single journey (cumulative distance fare) vs a new journey (separate fare calculation from zero).",
    "max_transfers_per_journey": 5,
    "max_journey_duration_minutes": 120,
    "transfer_time_limits": {
      "bus_to_bus_minutes": 45,
      "bus_to_train_minutes": 45,
      "train_to_bus_minutes": 45,
      "train_to_train_minutes": 15
    },
    "invalid_transfer_conditions": [
      "Same bus service number as preceding trip (including subsidiaries, e.g. 97/97e, 12/12e)",
      "Exit and re-entry at the same train station (except Bukit Panjang, Newton, Tampines interchange stations)",
      "Transfer time exceeded",
      "More than 5 transfers in a single journey",
      "Last tap-in exceeds 2 hours from first tap-in of journey"
    ],
    "interchange_exceptions": {
      "_description": "At these stations, tap-out and tap-in to transfer between lines is required and counts as a valid transfer if done within 15 minutes.",
      "stations": ["Bukit Panjang", "Newton", "Tampines"]
    }
  },

  "pre_peak_discount": {
    "_description": "Morning Pre-Peak Fares Scheme: discount on the rail leg of a journey for early travellers.",
    "enabled": true,
    "eligible_days": "weekdays_excluding_public_holidays",
    "tap_in_before": "07:45",
    "applies_to": "rail_leg_only",
    "discount_amount": 0.50,
    "discount_rule": "min(0.50, rail_leg_fare)",
    "notes": "Discount is $0.50 or the fare for the rail trip of the journey, whichever is lower. Applied only to the rail leg, not bus legs."
  },

